// Prototype schema: users/{uid}/entries/{entryId}
// Owner is fixed by the UID path; no public profile or shared diary collection.
// Required fields: date YYYY-MM-DD (10 chars), mood enum, title (1..100),
// body (1..30000), createdAt immutable timestamp, updatedAt current timestamp.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isValidEntry(data) {
      return data.keys().hasAll(['date','mood','title','body','createdAt','updatedAt'])
        && data.keys().hasOnly(['date','mood','title','body','createdAt','updatedAt'])
        && data.date is string && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && data.mood in ['happy','calm','excited','sad','tired']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.body is string && data.body.size() > 0 && data.body.size() <= 30000
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid}/entries/{entryId} {
      allow get: if isOwner(uid);
      allow list: if isOwner(uid) && request.query.limit <= 500;
      allow create: if isOwner(uid) && isValidEntry(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && isValidEntry(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }
    match /{document=**} { allow read,write: if false; }
  }
}
